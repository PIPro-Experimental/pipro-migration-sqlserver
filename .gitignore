# Per-user connection settings: copy settings.example.txt -> settings.local.txt.
# The example is committed; the real one holds your DB details and password.
settings.local.txt

# Per-client conversion manifest (copy payrolls.example.csv -> payrolls.csv).
payrolls.csv
# ... and its catalogue overrides (copy catalogue-overrides.example.csv).
catalogue-overrides.csv

# Report output from compare_report.ps1 - names real employees.
/reports/

# Local environment overrides — NEVER commit real DB credentials.
.env
.env.local
*.local

# Legacy data dumps / staging artifacts (can be large and/or sensitive).
*.dump
*.backup
*.sql.gz
*.tar
*.gz

# Logs / scratch
*.log
*.tmp
/scratch/

# OS / IDE
Thumbs.db
.DS_Store
.vscode/
.idea/
